numpy as np\nimport psutil\nimport matplotlib.pyplot as plt\n\nimport gdsfactory as gf\nfrom gdsfactory.technology import LogicalLayer, LayerLevel, LayerStack\nimport luminescent as lumi\n\ngf.gpdk.PDK.activate()\n\nnres_list = [6, 10, 15]\nh_wg = 0.22\nwavelength = 1.55\n# bandwidth = wavelength / 4\nbandwidth = wavelength / 12\nwavelengths = np.linspace(1.54, 1.56, 21).tolist()\n\n# domain margins [um]\nmargin = 1\nzmargin = 1\nzmin, zmax = -zmargin, h_wg + zmargin","key":"BLD3lBLBt8"},{"type":"outputs","id":"yhZo_MWXaQ4PpKCLDnsyI","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"lumi backend: ~/Luminescent/bin/lumi\n"},"children":[],"key":"FZ0pWjhber"}],"key":"dEmod0Twi9"}],"identifier":"3726e637","html_id":"3726e637","key":"eieWcd3qW8"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T16:26:14.084652Z","iopub.status.busy":"2026-11-07T16:26:14.084387Z","iopub.status.idle":"2026-11-07T16:26:14.088318Z","shell.execute_reply":"2026-11-07T16:26:14.088067Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def setup(path, nres):\n    # Si: lossless single-Lorentzian fit to the paper's Palik model (frequency in units of c / wavelength); SiO2: constant\n    materials = {\n        \"Si\": lumi.material(n=3.4729, epsilon=8.36218, dispersion=[lumi.lorentzian(3.0, 0, 3.2882)]),\n        \"SiO2\": lumi.material(1.4425),\n    }\n    WG = 1, 0\n    layer_stack = LayerStack(\n        layers={\n            \"core\": LayerLevel(\n                layer=LogicalLayer(layer=WG),\n                thickness=h_wg,\n                zmin=0,\n                material=\"Si\",\n                mesh_order=0,\n            ),\n        }\n    )\n\n    # GDSFactory generic 2x2 MMI with S-bends\n    dc = gf.components.mmi2x2_with_sbend()\n    xmin, ymin = dc.bbox_np()[0]\n    xmax, ymax = dc.bbox_np()[1]\n    bbox = [[xmin - margin, ymin - margin, zmin], [xmax + margin, ymax + margin, zmax]]\n\n    # 10 um port extensions, cropped to the domain\n    ext = gf.components.extend_ports(dc, length=10)\n    dbu = ext.kcl.dbu\n    arms = gf.kdb.Region(ext.begin_shapes_rec(ext.kcl.layer(*WG)))\n    window = gf.kdb.Region(gf.kdb.Box(*(round(v / dbu) for v in (bbox[0][0], bbox[0][1], bbox[1][0], bbox[1][1]))))\n    c = gf.Component()\n    c.add_polygon(arms & window, layer=WG)\n    for p in dc.ports:\n        c.add_port(p.name, center=p.center, width=p.width, orientation=p.orientation, layer=WG)\n    c.plot()\n\n    frames = [\n        lumi.plane_frame(\n            \"wg\",\n            start=[-1.2, zmin],\n            stop=[1.2, zmax],\n            wls_mode_solver=[wavelengths[0], wavelength, wavelengths[-1]],\n        )\n    ]\n    sources = [\n        lumi.gf_source(\"o1\", c, layer_stack, margin, frame=\"wg\", wl=wavelength, bandwidth=bandwidth)\n    ]\n    monitors = [lumi.gf_monitor(p, c, layer_stack, frame=\"wg\") for p in [\"o1\", \"o2\", \"o3\", \"o4\"]]\n\n    lumi.mesh(path, c, layer_stack, materials, zmin, zmax)\n    lumi.setup(\n        path=path,\n        wl=wavelength,\n        wls=wavelengths,\n        materials=materials,\n        background=\"SiO2\",\n        boundaries=[\"PML\", \"PML\", \"PML\"],\n        PML_decay=[0.001, 0.001, 0.1],\n        bbox=bbox,\n        frames=frames,\n        sources=sources,\n        monitors=monitors,\n        nres=nres,\n        tmax=1000,  # periods\n        shutoff=1e-4,\n        views=[lumi.view(\"Hz\", z=h_wg / 2)],\n        shot_every=10,\n    )\n    return c","key":"hSHuy7jRym"},{"type":"outputs","id":"tJQ6cVDVz60BiY7hSHizr","children":[],"key":"td2RjXAHR6"}],"identifier":"42ce4726","html_id":"42ce4726","key":"iYXorXEoxF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simular","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vhrXxsWQXC"}],"identifier":"simular","label":"Simular","html_id":"simular","implicit":true,"key":"Uf9YUjFkGq"}],"identifier":"f478b85d","html_id":"f478b85d","key":"LGqxU5UaKF"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T16:26:14.088939Z","iopub.status.busy":"2026-11-07T16:26:14.088876Z","iopub.status.idle":"2026-11-07T16:26:14.091534Z","shell.execute_reply":"2026-11-07T16:26:14.091327Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def gpu_used():\n    out = subprocess.run([\"nvidia-smi\", \"--query-gpu=memory.used\", \"--format=csv,noheader,nounits\"], capture_output=True, text=True).stdout\n    return sum(float(v) for v in out.split()) / 1024  # GB\n\n\ndef solve_with_stats(path):\n    \"\"\"solve, tracking wall time, peak GPU memory (above baseline) and peak solver host RSS\"\"\"\n    peak = {\"gpu\": 0.0, \"host\": 0.0}\n    base = gpu_used()\n    me = psutil.Process()\n    done = threading.Event()\n\n    def poll():\n        while not done.is_set():\n            peak[\"gpu\"] = max(peak[\"gpu\"], gpu_used() - base)\n            rss = 0\n            for p in me.children(recursive=True):\n                try:\n                    rss += p.memory_info().rss\n                except psutil.Error:\n                    pass\n            peak[\"host\"] = max(peak[\"host\"], rss / 1024**3)\n            time.sleep(0.5)\n\n    t = threading.Thread(target=poll)\n    t.start()\n    t0 = time.time()\n    try:\n        lumi.solve(path)\n    finally:\n        done.set()\n        t.join()\n    stats = {\"runtime\": time.time() - t0, \"gpu_GB\": peak[\"gpu\"], \"host_GB\": peak[\"host\"]}\n    json.dump(stats, open(os.path.join(path, \"stats.json\"), \"w\"))\n    return stats","key":"Au7bOfRwFS"},{"type":"outputs","id":"IgWZhQaDmNwAUnjYQAfOz","children":[],"key":"uLclrkBY7S"}],"identifier":"1c2fa23e","html_id":"1c2fa23e","key":"nzEKCFODpx"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T16:26:14.092058Z","iopub.status.busy":"2026-11-07T16:26:14.092000Z","iopub.status.idle":"2026-11-07T16:34:21.005962Z","shell.execute_reply":"2026-11-07T16:34:21.005507Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"for nres in nres_list:\n    path = os.path.join(\"runs\", f\"mmi_nres{nres}\")\n    setup(path, nres)\n    print(solve_with_stats(path))","key":"ATzm0y0GIl"},{"type":"outputs","id":"TvaSqznAjG37oDcmBb-rR","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"393f0838e3a889254bcc9ae4085568f5","path":"/es/_public/393f0838e3a889254bcc9ae4085568f5.png"},"text/plain":{"content":"<Figure size 800x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"yj8VUijm3x"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"029e9345ff4b5d754a1af161e5f4a078","path":"/es/_public/029e9345ff4b5d754a1af161e5f4a078.png"},"text/plain":{"content":"<Figure size 640x480 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"bj1eKPjsnl"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"using simulation folder runs/mmi_nres6\n"},"children":[],"key":"c3I6G90jDn"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"========================================\nbackend using simulation folder runs/mmi_nres6\n"},"children":[],"key":"B3hdpIwU1L"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"========================================\nsetting up simulation...\n"},"children":[],"key":"cG6lx1KIC3"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"processing geometry bodies...\n"},"children":[],"key":"qyKMunQSVc"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"generating voxels...\n"},"children":[],"ke