\"nres {nres}\")\n\nfmt = lambda v, f: \"–\" if v is None else format(v, f)\nprint(\"nres  cross T  through T  excess loss  runtime  GPU mem  host mem\")\nfor nres, t3, t4, l, rt, g, h in rows:\n    print(f\"{nres:4d}  {100*t3:6.1f} %  {100*t4:7.1f} %  {l:8.3f} dB  {fmt(rt, '5.0f'):>5} s  {fmt(g, '5.2f'):>5} GB  {fmt(h, '5.2f'):>5} GB\")\n\nax[0].set(xlabel=\"wavelength [um]\", ylabel=\"cross transmittance\")\nax[1].set(xlabel=\"wavelength [um]\", ylabel=\"excess loss [dB]\")\nax[0].legend()\nplt.tight_layout()\nplt.show()","key":"tbFH6BMCtH"},{"type":"outputs","id":"t8Ev0HRR7JkMVhqqamg5L","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"loading solution from runs/mmi_nres6\nmay take a minute if simulation folder is remotely mounted\nloading solution from runs/mmi_nres10\nmay take a minute if simulation folder is remotely mounted\nloading solution from runs/mmi_nres15\nmay take a minute if simulation folder is remotely mounted\nnres  cross T  through T  excess loss  runtime  GPU mem  host mem\n   6    35.3 %     47.0 %     0.843 dB    127 s   1.24 GB   2.46 GB\n  10    45.7 %     49.2 %     0.227 dB    154 s   3.08 GB   3.59 GB\n  15    47.6 %     48.4 %     0.177 dB    205 s   9.80 GB   4.73 GB\n"},"children":[],"key":"EPH5M8AxtL"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"73a3c5822df448d662470fcd9dafcd15","path":"/es/_public/73a3c5822df448d662470fcd9dafcd15.png"},"text/plain":{"content":"<Figure size 1000x400 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"PgREHZNUy3"}],"key":"CBLncGeEoN"}],"identifier":"ced902be","html_id":"ced902be","key":"IsNcLP3EUg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Comparación de la Fig. 12a","position":{"start":{"line":1,"column":1},"end":{