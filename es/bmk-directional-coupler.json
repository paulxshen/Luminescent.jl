\"+\"] / a1) ** 2  # cross\n    T4 = np.abs(m[\"o4\"][\"modes\"][0][\"+\"] / a1) ** 2  # through\n    loss = -10 * np.log10(T3 + T4)\n    f = os.path.join(path, \"stats.json\")\n    st = json.load(open(f)) if os.path.exists(f) else {}\n    rows.append((nres, T3[i], T4[i], loss[i], st.get(\"runtime\"), st.get(\"gpu_GB\"), st.get(\"host_GB\")))\n    ax[0].plot(wls, T3, label=f\"nres {nres}\")\n    ax[1].plot(wls, loss, label=f\"nres {nres}\")\n\nfmt = lambda v, f: \"–\" if v is None else format(v, f)\nprint(\"nres  cross T  through T  excess loss  runtime  GPU mem  host mem\")\nfor nres, t3, t4, l, rt, g, h in rows:\n    print(f\"{nres:4d}  {100*t3:6.1f} %  {100*t4:7.1f} %  {l:8.3f} dB  {fmt(rt, '5.0f'):>5} s  {fmt(g, '5.2f'):>5} GB  {fmt(h, '5.2f'):>5} GB\")\n\nax[0].set(xlabel=\"wavelength [um]\", ylabel=\"cross transmittance\")\nax[1].set(xlabel=\"wavelength [um]\", ylabel=\"excess loss [dB]\")\nax[0].legend()\nplt.tight_layout()\nplt.show()","key":"QnBhJ0Rw2s"},{"type":"outputs","id":"LCfUsgpoyaMFaNuz-H0jf","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"loading solution from runs/dc_nres6\nmay take a minute if simulation folder is remotely mounted\nloading solution from runs/dc_nres10\nmay take a minute if simulation folder is remotely mounted\nloading solution from runs/dc_nres15\nmay take a minute if simulation folder is remotely mounted\nnres  cross T  through T  excess loss  runtime  GPU mem  host mem\n   6    43.6 %     51.4 %     0.223 dB    138 s   1.36 GB   2.54 GB\n  10    41.3 %     57.8 %     0.040 dB    158 s   3.61 GB   3.87 GB\n  15    43.3 %     55.8 %     0.038 dB    287 s  11.55 GB   5.11 GB\n"},"children":[],"key":"JZe1gaAU8o"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5a9eb673786e9139b53287d96512d92d","path":"/es/_public/5a9eb673786e9139b53287d96512d92d.png"},"text/plain":{"content":"<Figure size 1000x400 with 2 