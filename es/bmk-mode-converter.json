:"e00b14ec","html_id":"e00b14ec","key":"sh17OykFQb"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Identificación de modos","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"duRO2Wl3Wi"}],"identifier":"identificaci-n-de-modos","label":"Identificación de modos","html_id":"identificaci-n-de-modos","implicit":true,"key":"hposqKASfw"}],"identifier":"b2808c49","html_id":"b2808c49","key":"GyVHAksXce"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T17:05:24.693465Z","iopub.status.busy":"2026-11-07T17:05:24.693388Z","iopub.status.idle":"2026-11-07T17:05:24.697738Z","shell.execute_reply":"2026-11-07T17:05:24.697507Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def classify(path, frame=\"mm\", wl=1.55):\n    \"\"\"per solved mode: TE fraction (lateral E energy) and lateral parity of the dominant E (+1 even, -1 odd)\"\"\"\n    out = []\n    for i in range(nmodes_mm):\n        d = np.load(os.path.join(path, \"modes\", frame, str(wl), f\"{i}.npz\"))\n        ex, ey = d[\"Ex\"], d[\"Ey\"]\n        te = (abs(ex) ** 2).sum() / ((abs(ex) ** 2).sum() + (abs(ey) ** 2).sum())\n        a = ex if te > 0.5 else ey\n        parity = np.real(np.vdot(a, a[::-1, :])) / np.real(np.vdot(a, a))\n        out.append((te, parity))\n    return out\n\n\ndef te_modes(path):\n    \"\"\"indices of TE0 (TE-like, even) and TE1 (TE-like, odd) at the wide port\"\"\"\n    c = classify(path)\n    for i, (te, par) in enumerate(c):\n        print(f\"mode {i}: TE fraction {te:.3f}, parity {par:+.2f}\")\n    te0 = next(i for i, (te, par) in enumerate(c) if te > 0.5 and par > 0)\n    te1 = next(i for i, (te, par) in enumerate(c) if te > 0.5 and par < 0)\n    return te0, te1\n\n\nte0, te1 = te_modes(os.path.join(\"runs\", f\"mc_nres{nres_list[0]}\"))\nprint(f\"TE0 = mode {te0}, TE1 = mode {te1}\")","key":"n9FKBAJaTe"},{"type":"outputs","id":"0llHwEsbXvK4uXatw4Cjs","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"mode 0: TE fraction 0.985, parity +1.00\nmode 1: TE fraction 0.931, parity -1.00\nmode 2: TE fraction 0.038, parity +1.00\nTE0 = mode 0, TE1 = mode 1\n"},"children":[],"key":"YPPFpZhLrj"}],"key":"e1xmNRUeFX"}],"identifier":"5773b718","html_id":"5773b718","key":"iAYLeTswRG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Resultados","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ybqi8cnH5p"}],"identifier":"resultados","label":"Resultados","html_id":"resultados","implicit":true,"key":"UubUz4dyuV"}],"identifier":"e9a9ae8e","html_id":"e9a9ae8e","key":"etmILt6aKJ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T17:05:24.698514Z","iopub.status.busy":"2026-11-07T17:05:24.698447Z","iopub.status.idle":"2026-11-07T17:05:24.817210Z","shell.execute_reply":"2026-11-07T17:05:24.816803Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"wls_nm = 1000 * np.array(wavelengths)\ni0 = np.argmin(abs(wls_nm - 1550))\nrows = []\nfig, ax = plt.subplots(1, 2, figsize=(10, 3.8))\nfor nres in [6, 10, 15, 20, 25]:\n    path = os.path.join(\"runs\", f\"mc_nres{nres}\")\n    if not os.path.exists(os.path.join(path, \"solution.json\")):\n        continue\n    k0, k1 = te_modes(path)\n    m = lumi.load(path)[\"monitors\"]\n    a = np.array(m[\"o2\"][\"modal\"][0][\"-\"])\n    T1 = np.abs(np.array(m[\"o3\"][\"modal\"][k1][\"+\"]) / a) ** 2  # TE1, cross port\n    X = 10 * np.log10(np.abs(np.array(m[\"o3\"][\"modal\"][k0][\"+\"]) / a) ** 2)  # TE0 crosstalk, cross port\n    Tt = np.abs(np.array(m[\"o4\"][\"modal\"][0][\"+\"]) / a) ** 2  # TE0, through port\n    R = np.abs(np.array(m[\"o2\"][\"modal\"][0][\"+\"]) / a) ** 2\n    f = os.path.join(path, \"stats.json\")\n    st = json.load(open(f)) if os.path.exists(f) else {}\n    rows.append((nres, T1[i0], X[i0], Tt[i0], R[i0], st.get(\"runtime\"), st.get(\"gpu_GB\"), st.get(\"host_GB\")))\n    ax[0].plot(wls_nm, T1, label=f\"nres {nres}\")\n    ax[1].plot(wls_nm, X, label=f\"nres {nres}\")\n\nfmt = lambda v, f: \"–\" if v is None else format(v, f)\nprint(\"nres  TE1 cross  crosstalk  through  reflect  runtime  GPU mem  host mem\")\nfor nres, t1, x, tt, r, rt, g, h in rows:\n    print(f\"{nres:4d}  {t1:9.3f}  {x:6.1f} dB  {tt:7.3f}  {r:7.4f}  {fmt(rt, '5.0f'):>5} s  {fmt(g, '5.2f'):>5} GB  {fmt(h, '5.2f'):>5} GB\")\n\nax[0].set(xlabel=\"wavelength [nm]\", ylabel=\"TE1 transmission, cross port\")\nax[1].set(xlabel=\"wavelength [nm]\", ylabel=\"TE0 crosstalk [dB]\")\nax[0].legend()\nplt.tight_layout()\nplt.show()","key":"Nm0Ky7wfRt"},{"type":"outputs","id":"XHyKlk2fF5POOyv738YBe","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"mode 0: TE fraction 0.990, parity +1.00\nmode 1: TE fraction 0.955, parity -1.00\nmode 2: TE fraction 0.038, parity +1.00\nloading solution from runs/mc_nres6\nmay take a minute if simulation folder is remotely mounted\nmode 0: TE fraction 0.999, parity +1.00\nmode 1: TE fraction 0.995, parity -1.00\nmode 2: TE fraction 0.975, parity +1.00\nloading solution from runs/mc_nres10\nmay take a minute if simulation folder is remotely mounted\nmode 0: TE fraction 0.985, parity +1.00\nmode 1: TE fraction 0.931, parity -1.00\nmode 2: TE fraction 0.038, parity +1.00\nloading solution from runs/mc_nres15\nmay take a minute if simulation folder is remotely mounted\nnres  TE1 cross  crosstalk  through  reflect  runtime  GPU mem  host mem\n   6      0.502   -59.6 dB    0.407   0.0061    146 s  12.39 GB   2.60 GB\n  10      0.510   -34.3 dB    0.431   0.0055    229 s  12.37 GB   4.56 GB\n  15      0.456   -33.9 dB    0.495   0.0028    533 s  25.86 GB  10.24 GB\n"},"children":[],"key":"VQAWdNzX16"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"9cc2014fdc05e0037eb1d774b05a1782","path":"/es/_public/9cc2014fdc05e0037eb1d774b05a1782.png"},"text/plain":{"content":"<Figure size 1000x380 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"BVxaC8fpza"}],"key":"jzg7IIpDVh"}],"identifier":"daaff9bd","html_id":"daaff9bd","key":"bdKaOxRYxI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Comparación de la Fig. 16a, c","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RJ7UlwJSTL"}],"identifier":"comparaci-n-de-la-fig-16a-c","label":"Comparación de la Fig. 16a, c","html_id":"comparaci-n-de-la-fig-16a-c","implicit":true,"key":"iYIkUpN7ZZ"}],"identifier":"484d417f","html_id":"484d417f","key":"UYBu3vHyMA"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T17:05:24.817988Z","iopub.status.busy":"2026-11-07T17:05:24.817912Z","iopub.status.idle":"2026-11-07T17:05:24.928125Z","shell.execute_reply":"2026-11-07T17:05:24.927781Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# paper Fig. 16a, c, digitized\nnres_paper = [6, 10, 15, 20, 25]\npaper = {\n    \"TE1 transmission\": ([0.357, 0.261, 0.492, 0.479, 0.430], [0.966, 0.512, 0.443, 0.482, 0.512]),\n    \"crosstalk [dB]\": ([-39.6, -34.2, -35.4, -35.3, -35.6], [-47.3, -38.6, -37.3, -38.1, -36.9]),\n}\nfig, ax = plt.subplots(1, 2, figsize=(10, 3.5))\nfor a, (name, (tidy3d, lumerical)), col in zip(ax, paper.items(), [1, 2]):\n    a.plot(nres_paper, lumerical, \"o-\", color=\"red\", label=\"Lumerical\")\n    a.plot(nres_paper, tidy3d, \"o-\", color=\"blue\", label=\"Tidy3D\")\n    a.plot([r[0] for r in rows], [r[col] for r in rows], \"o-\", color=\"black\", label=\"Luminescent\")\n    a.set(xlabel=\"nres (cells per wavelength)\", title=name)\n    a.grid(alpha=0.3)\nax[0].legend()\nplt.tight_layout()\nplt.show()","key":"Qxs5RrYLbE"},{"type":"outputs","id":"QamJYE-w1z1Mzds1D7dGO","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"d6fac3289de6597f5c0c18818e0d42b6","path":"/es/_public/d6fac3289de6597f5c0c18818e0d42b6.png"},"text/plain":{"content":"<Figure size 1000x350 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"XfYQEIzcVi"}],"key":"QCyopv6sDn"}],"identifier":"e7d554bd","html_id":"e7d554bd","key":"umMcAKlSXr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Película","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"y8JjAjEgoq"}],"identifier":"pel-cula","label":"Película","html_id":"pel-cula","implicit":true,"key":"zx9tQVmHXj"}],"identifier":"d675994f","html_id":"d675994f","key":"yxJvC0ofrY"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T17:05:24.928879Z","iopub.status.busy":"2026-11-07T17:05:24.928810Z","iopub.status.idle":"2026-11-07T17:05:24.931620Z","shell.execute_reply":"2026-11-07T17:05:24.931317Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"lumi.movie(os.path.join(\"runs\", f\"mc_nres{nres_list[-1]}\"))","key":"B9XMYfOqIL"},{"type":"outputs","id":"xUCkqFtFhn6vUy4OpdUZg","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/webp":{"content_type":"image/webp","hash":"aaec1b24a017c47aedb1022500b5c085","path":"/es/_public/aaec1b24a017c47aedb1022500b5c085.webp"},"text/plain":{"content":"<IPython.core.display.Image object>","content_type":"text/plain"}}},"children":[],"key":"dFUDwi5E7n"}],"key":"C5I8IvALvN"}],"i