:\n    print(f\"{nres:4d}  {100*t3:6.1f} %  {100*t4:7.1f} %  {l:8.3f} dB  {fmt(rt, '5.0f'):>5} s  {fmt(g, '5.2f'):>5} GB  {fmt(h, '5.2f'):>5} GB\")\n\nax[0].set(xlabel=\"wavelength [um]\", ylabel=\"cross transmittance\")\nax[1].set(xlabel=\"wavelength [um]\", ylabel=\"excess loss [dB]\")\nax[0].legend()\nplt.tight_layout()\nplt.show()","key":"E3U3NHfvh0"},{"type":"outputs","id":"6v46WiOQYWJC74p48ii5v","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"loading solution from runs/mmi_nres6\nmay take a minute if simulation folder is remotely mounted\nloading solution from runs/mmi_nres10\nmay take a minute if simulation folder is remotely mounted\nloading solution from runs/mmi_nres15\nmay take a minute if simulation folder is remotely mounted\nnres  cross T  through T  excess loss  runtime  GPU mem  host mem\n   6    35.3 %     47.0 %     0.843 dB    127 s   1.24 GB   2.46 GB\n  10    45.7 %     49.2 %     0.227 dB    154 s   3.08 GB   3.59 GB\n  15    47.6 %     48.4 %     0.177 dB    205 s   9.80 GB   4.73 GB\n"},"children":[],"key":"ApNKzS2PX2"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"73a3c5822df448d662470fcd9dafcd15","path":"/Luminescent.jl/_public/73a3c5822df448d662470fcd9dafcd15.png"},"text/plain":{"content":"<Figure size 1000x400 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"qlezQfZujh"}],"key":"KbqvEFy8W9"}],"identifier":"ced902be","html_id":"ced902be","key":"oA86wBvhs5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Fig. 12a comparison","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kAeWxAVmii"}],"identifier":"fig-12a-comparison","label":"Fig. 12a comparison","html_id":"fig-12a-comparison","implicit":true,"key":"raZmCSCzuS"}],"identifier"