}},"children":[{"type":"code","lang":"python","executable":true,"value":"import os, time, json, threading, subprocess\nimport numpy as np\nimport psutil\nimport matplotlib.pyplot as plt\n\nimport gdsfactory as gf\nfrom gdsfactory.technology import LogicalLayer, LayerLevel, LayerStack\nimport luminescent as lumi\n\ngf.gpdk.PDK.activate()\n\nnres_list = [15]\nh_wg = 0.22\nwavelength = 1.55\n# bandwidth = wavelength / 4\nbandwidth = wavelength / 12\nwavelengths = np.linspace(1.54, 1.56, 41).tolist()  # 0.5 nm step\nwls_mode_solver = [1.54, 1.55, 1.56]\nnmodes_mm = 3  # modes solved at the wide port\n\n# domain margins [um]\nmargin = 1\nzmargin = 1\nzmin, zmax = -zmargin, h_wg + zmargin","key":"Q335fwYmv0"},{"type":"outputs","id":"TVhrVPzUED-X575YnJhG7","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"lumi backend: ~/Luminescent/bin/lumi\n"},"children":[],"key":"qRaWegl9Nm"}],"key":"O57FrEBZfN"}],"identifier":"2f0af0ea","html_id":"2f0af0ea","key":"C2rxdhCRlv"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T16:56:31.363829Z","iopub.status.busy":"2026-11-07T16:56:31.363555Z","iopub.status.idle":"2026-11-07T16:56:31.368275Z","shell.execute_reply":"2026-11-07T16:56:31.367957Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"@gf.cell\ndef bend_euler_s45(cross_section=\"strip\"):\n    \"\"\"S-bend from two 45° Euler bends, as in the paper's GDSFactory 7.8 mode_converter\"\"\"\n    c = gf.Component()\n    b = gf.components.bend_euler(angle=45, cross_section=cross_section)\n    b1 = c << b\n    b2 = c << b\n    b2.connect(\"o1\", b1.ports[\"o2\"], mirror=True)\n    c.add_port(\"o1\", port=b1.ports[\"o1\"])\n    c.add_port(\"o2\", port=b2.ports[\"o2\"])\n    c.flatten()\n    return c\n\n\ndef setup(path, nres):\n    # Si: lossless single-Lorentzian fit to the paper's Palik model (frequency in units of c / wavelength); SiO2: constant\n    materials = {\n        \"Si\": lumi.material(n=3.4729, epsilon=8.36218, dispersion=[lumi.lorentzian(3.0, 0, 3.2882)]),\n        \"SiO2\": lumi.material(1.4425),\n    }\n    WG = 1, 0\n    layer_stack = LayerStack(\n        layers={\n            \"core\": LayerLevel(\n                layer=LogicalLayer(layer=WG),\n                thickness=h_wg,\n                zmin=0,\n                material=\"Si\",\n                mesh_order=0,\n            ),\n        }\n    )\n\n    # o1, o3: wide (1.2 um) arm; o2, o4: narrow (0.5 um) arm. Input o2, cross port o3\n    mc = gf.components.mode_converter(gap=0.15, length=20, bend=bend_euler_s45)\n    # mc = gf.components.mode_converter(gap=0.15, length=20)\n    xmin, ymin = mc.bbox_np()[0]\n    xmax, ymax = mc.bbox_np()[1]\n    bbox = [[xmin - margin, ymin - margin, zmin], [xmax + margin, ymax + margin, zmax]]\n\n    # port extensions long enough to cross the domain edge (the narrow ports sit inside it), cropped to the domain\n    ext = gf.components.extend_ports(mc, length=20)\n    # ext = gf.components.extend_ports(mc, length=10)\n    dbu = ext.kcl.dbu\n    wg = gf.kdb.Region(ext.begin_shapes_rec(ext.kcl.layer(*WG)))\n    window = gf.kdb.Region(gf.kdb.Box(*(round(v / dbu) for v in (bbox[0][0], bbox[0][1], bbox[1][0], bbox[1][1]))))\n    c = gf.Component()\n    c.add_polygon(wg & window, layer=WG)\n    for p in mc.ports:\n        c.add_port(p.name, center=p.center, width=p.width, orientation=p.orientation, layer=WG)\n    c.plot()\n\n    frames = [\n        lumi.plane_frame(\"sm\", start=[-1.2, zmin], stop=[1.2, zmax], wls_mode_solver=wls_mode_solver),\n        lumi.plane_frame(\"mm\", start=[-1.5, zmin], stop=[1.5, zmax], wls_mode_solver=wls_mode_solver, nmodes=nmodes_mm),\n    ]\n    sources = [lumi.gf_source(\"o2\", c, layer_stack, margin, frame=\"sm\", wl=wavelength, bandwidth=bandwidth)]\n    monitors = [\n        lumi.gf_monitor(\"o2\", c, layer_stack, frame=\"sm\"),\n        lumi.gf_monitor(\"o4\", c, layer_stack, frame=\"sm\"),\n        lumi.gf_monitor(\"o3\", c, layer_stack, frame=\"mm\"),\n    ]\n\n    lumi.mesh(path, c, layer_stack, materials, zmin, zmax)\n    lumi.setup(\n        path=path,\n        wl=wavelength,\n        wls=wavelengths,\n        materials=materials,\n        background=\"SiO2\",\n        boundaries=[\"PML\", \"PML\", \"PML\"],\n        PML_decay=[0.001, 0.001, 0.1],\n        bbox=bbox,\n        frames=frames,\n        sources=sources,\n        monitors=monitors,\n        nres=nres,\n        tmax=2000,\n        shutoff=1e-5,\n        dtype=\"f32\",\n        views=[lumi.view(\"Hz\", z=h_wg / 2)],\n        shot_every=10,\n    )\n    return c","key":"FjZsIwcPGO"},{"type":"outputs","id":"K3MGF8zjdVLW7J-G2VsbC","children":[],"key":"r6p3RdVzWW"}],"identifier":"f5fe4265","html_id":"f5fe4265","key":"szzHPZg24P"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simulate","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YVTLHSOYze"}],"identifier":"simulate","label":"Simulate","html_id":"simulate","implicit":true,"key":"FVgKVFqPYA"}],"identifier":"adc29add","html_id":"adc29add","key":"JLuMnr7Ly6"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T16:56:31.368973Z","iopub.status.busy":"2026-11-07T16:56:31.368910Z","iopub.status.idle":"2026-11-07T16:56:31.371588Z","shell.execute_reply":"2026-11-07T16:56:31.371323Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def gpu_used():\n    out = subprocess.run([\"nvidia-smi\", \"--query-gpu=memory.used\", \"--format=csv,noheader,nounits\"], capture_output=True, text=True).stdout\n    return sum(float(v) for v in out.split()) / 1024  # GB\n\n\ndef solve_with_stats(path):\n    \"\"\"solve, tracking wall time, peak GPU memory (above baseline) and peak solver host RSS\"\"\"\n    peak = {\"gpu\": 0.0, \"host\": 0.0}\n    base = gpu_used()\n    me = psutil.Process()\n    done = threading.Event()\n\n    def poll():\n        while not done.is_set():\n            peak[\"gpu\"] = max(peak[\"gpu\"], gpu_used() - base)\n            rss = 0\n            for p in me.children(recursive=True):\n                try:\n                    rss += p.memory_info().rss\n                except psutil.Error:\n                    pass\n            peak[\"host\"] = max(peak[\"host\"], rss / 1024**3)\n            time.sleep(0.5)\n\n    t = threading.Thread(target=poll)\n    t.start()\n    t0 = time.time()\n    try:\n        lumi.solve(path)\n    finally:\n        done.set()\n        t.join()\n    stats = {\"runtime\": time.time() - t0, \"gpu_GB\": peak[\"gpu\"], \"host_GB\": peak[\"host\"]}\n    json.dump(stats, open(os.path.join(path, \"stats.json\"), \"w\"))\n    return stats","key":"ShdEAbS0yk"},{"type":"outputs","id":"84WmhSHjPL65LR2-hOWlN","children":[],"key":"DraY7tWDm1"}],"identifier":"da824376","html_id":"da824376","key":"KPDAPkAQKh"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T16:56:31.372351Z","iopub.status.busy":"2026-11-07T16:56:31.372290Z","iopub.status.idle":"2026-11-07T17:05:24.692373Z","shell.execute_reply":"2026-11-07T17:05:24.691931Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"for nres in nres_list:\n    path = os.path.join(\"runs\", f\"mc_nres{nres}\")\n    setup(path, nres)\n    print(solve_with_stats(path))","key":"ehPqPJeCsw"},{"type":"outputs","id":"t0IycXdUwoSF4dDG-2x0W","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"~/.local/lib/python3.14/site-packages/cachetools/_cached.py:185: UserWarning: bend_euler angle should be 90 or 180. Got 45. Use bend_euler_all_angle instead.\n  v = func(*args, **kwargs)\n"},"children":[],"key":"YYoLy0K4dp"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"