{"version":3,"kind":"Notebook","sha256":"4a2fa8415a86d0965d537b69956f1c54d2617572a709386fbd8bfded4ad400d0","slug":"soi-coupler","location":"/SOI_coupler.ipynb","dependencies":[],"frontmatter":{"title":"SOI directional coupler: Tidy3D comparison","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"github":"https://github.com/paulxshen/Luminescent.jl","numbering":{"title":{"offset":2}},"source_url":"https://github.com/paulxshen/Luminescent.jl/blob/main/docs/SOI_coupler.ipynb","edit_url":"https://github.com/paulxshen/Luminescent.jl/edit/main/docs/SOI_coupler.ipynb","exports":[{"format":"ipynb","filename":"SOI_coupler.ipynb","url":"/_public/SOI_coupler-69f15d3f551f957a30c920f6e6ed425f.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Replicates Tidy3D’s ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dpF21aoeJu"},{"type":"link","url":"https://www.flexcompute.com/tidy3d/examples/notebooks/DirectionalCoupler/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"directional coupler","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"q39HmZihqa"}],"urlSource":"https://www.flexcompute.com/tidy3d/examples/notebooks/DirectionalCoupler/","key":"YLAPdZZH4l"},{"type":"text","value":" example. Silicon arms (n = 3.48, 0.22 µm thick, 30° sidewalls) on oxide (n = 1.45), air above. Layout from Tidy3D’s ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VSraQa5cuj"},{"type":"inlineCode","value":"coupler.gds","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HP4sNpXxiu"},{"type":"text","value":", dilated by 20 nm per side. Light enters port 1 (lower left). We find the wavelength where power splits evenly between ports 3 and 4. Tidy3D reports 1.53 µm with total transmission 0.990 at equivalent nres=15.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wncUw73hDw"}],"key":"xv9tJUqfge"}],"identifier":"f5114834","html_id":"f5114834","key":"ADftfsXUm2"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"link","url":"https://colab.luminescentai.com/hub/user-redirect/lab/tree/tutorials/photonic_circuits/SOI_coupler/SOI_coupler.ipynb","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Run in Lumi Colab","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gM0YrjtUL5"}],"urlSource":"https://colab.luminescentai.com/hub/user-redirect/lab/tree/tutorials/photonic_circuits/SOI_coupler/SOI_coupler.ipynb","key":"qGWWUMlkRb"}],"key":"yADpTbxjob"}],"key":"rAdEFxkNFj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Setup","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KbzI4chkJa"}],"identifier":"setup","label":"Setup","html_id":"setup","implicit":true,"key":"lZvOKbuvoc"}],"identifier":"f455d25c","html_id":"f455d25c","key":"ROcR8YLNtP"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-17T14:46:53.012516Z","iopub.status.busy":"2026-11-17T14:46:53.012444Z","iopub.status.idle":"2026-11-17T14:46:54.132965Z","shell.execute_reply":"2026-11-17T14:46:54.132600Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import os\nimport numpy as np\nimport matplotlib.pyplot as plt\n\nimport gdsfactory as gf\nfrom gdsfactory.technology import LogicalLayer, LayerLevel, LayerStack\nimport luminescent as lumi\n\n# Tidy3D's coupler.gds: 0.45 um arms, 0.1 um gap, 4 um coupling length\ngds_file = \"coupler.gds\"\ndilation = 0.02  # per side, at waveguide bottom\nsidewall_angle = 30  # deg from vertical\nh_wg = 0.22\n\n# domain, port positions [um]\nlx, ly = 17, 7\nx_port = 8\ny_port = 2\nsource_offset = 1\n\n# 21 frequencies over 1.4 - 1.7 um\nwavelengths = np.sort(1 / np.linspace(1 / 1.7, 1 / 1.4, 21)).tolist()\nwavelength = 2 / (1 / 1.4 + 1 / 1.7)\n\n\ndef setup(path,  sidewall_angle=sidewall_angle):\n    nres=10\n    shutoff = 1e-3\n    tmax = 1000  # max time [periods]\n    PML_decay = [0.001, 0.01, 0.1]\n    shot_every = 10\n    boundaries = [\"PML\", \"PML\", \"PML\"]\n    zmin, zmax = -1.11, 1.11\n    views = [lumi.view(\"Hz\", z=h_wg / 2)]\n\n    materials = {\n        \"Si\": lumi.material(3.48),\n        \"SiO2\": lumi.material(1.45),\n        \"air\": lumi.material(1),\n    }\n    background = \"air\"\n\n    WG = 1, 0\n    BOX = 2, 0\n    layer_stack = LayerStack(\n        layers={\n            \"core\": LayerLevel(\n                layer=LogicalLayer(layer=WG),\n                thickness=h_wg,\n                zmin=0,\n                material=\"Si\",\n                mesh_order=0,\n                sidewall_angle=sidewall_angle,\n            ),\n            \"box\": LayerLevel(\n                layer=LogicalLayer(layer=BOX),\n                thickness=-zmin,\n                zmin=zmin,\n                material=\"SiO2\",\n                mesh_order=1,\n            ),\n        }\n    )\n\n    # import arms, dilate, crop to domain (extended left to fit source)\n    gds = gf.import_gds(gds_file)\n    dbu = gds.kcl.dbu\n    arms = gf.kdb.Region(gds.begin_shapes_rec(gds.kcl.layer(1, 0)))\n    arms = arms.sized(round(dilation / dbu))\n    xmin = -max(lx / 2, x_port + source_offset)\n    window = gf.kdb.Region(gf.kdb.Box(round(xmin / dbu), round(-ly / 2 / dbu), round(lx / 2 / dbu), round(ly / 2 / dbu)))\n    c = gf.Component()\n    c.add_polygon(arms & window, layer=WG)\n    c.add_polygon(window, layer=BOX)\n\n    # o1: input (lower left), o2: upper left, o3: upper right, o4: lower right\n    w_wg = 0.45 + 2 * dilation\n    for name, x, y, a in [\n        (\"o1\", -x_port, -y_port, 180),\n        (\"o2\", -x_port, y_port, 180),\n        (\"o3\", x_port, y_port, 0),\n        (\"o4\", x_port, -y_port, 0),\n    ]:\n        c.add_port(name, center=(x, y), width=w_wg, orientation=a, layer=WG)\n    c.plot()\n\n    bbox = c.bbox_np().tolist()\n    bbox[0].append(zmin)\n    bbox[1].append(zmax)\n\n    frames = [\n        lumi.plane_frame(\n            \"wg\",\n            start=[-1, -0.5],\n            stop=[1, zmax],\n            wls_mode_solver=[1.4, wavelength, 1.7],\n        )\n    ]\n    sources = [\n        lumi.gf_source(\n            \"o1\", c, layer_stack, source_offset,\n            frame=\"wg\",\n            wl=wavelength,\n            bandwidth=wavelength / 8,\n        )\n    ]\n    monitors = [lumi.gf_monitor(p, c, layer_stack, frame=\"wg\") for p in [\"o1\", \"o2\", \"o3\", \"o4\"]]\n\n    lumi.mesh(path, c, layer_stack, materials, zmin, zmax)\n    lumi.setup(\n        path=path,\n        wl=wavelength,\n        wls=wavelengths,\n        materials=materials,\n        background=background,\n        boundaries=boundaries,\n        bbox=bbox,\n        frames=frames,\n        sources=sources,\n        monitors=monitors,\n        nres=nres,\n        tmax=tmax,\n        shutoff=shutoff,\n        PML_decay=PML_decay,\n        views=views,\n        shot_every=shot_every,\n    )\n    return c\n","key":"RG02N6qQ7x"},{"type":"outputs","id":"Vo91wEkVqUPpUJMkLsw2v","children":[],"key":"IZ8ddnjKZS"}],"identifier":"8c14340b","html_id":"8c14340b","key":"h27NXWfniD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Simulate","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R4OYmK8tpn"}],"identifier":"simulate","label":"Simulate","html_id":"simulate","implicit":true,"key":"No89QID0TT"}],"identifier":"7d035ef1","html_id":"7d035ef1","key":"R0pUGd1jgv"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-17T14:46:54.134080Z","iopub.status.busy":"2026-11-17T14:46:54.133788Z","iopub.status.idle":"2026-11-17T14:46:54.513446Z","shell.execute_reply":"2026-11-17T14:46:54.513127Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"path = os.path.join(\"runs\", \"SOI_coupler\")\nsetup(path)","key":"X88X0LITdD"},{"type":"outputs","id":"DyCocnIwZunVZTUrrC6LB","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"983ec596c6e8abad37957372edd69117","path":"/_public/983ec596c6e8abad37957372edd69117.png"},"text/plain":{"content":"<Figure size 800x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"HP2ZkKE5CY"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"dad99b87550864b99a5260cb770f9343","path":"/_public/dad99b87550864b99a5260cb770f9343.png"},"text/plain":{"content":"<Figure size 640x480 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"eoJryzY6Oe"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"using simulation folder runs/SOI_coupler\n"},"children":[],"key":"ZLtnKxCXBi"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"983ec596c6e8abad37957372edd69117","path":"/_public/983ec596c6e8abad37957372edd69117.png"},"text/plain":{"content":"<Figure size 800x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"coFabjFw8t"}],"key":"s33TyJLV3j"}],"identifier":"ac267708","html_id":"ac267708","key":"DtKEUpYUAp"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.exec