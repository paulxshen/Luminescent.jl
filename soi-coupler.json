type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"========================================\nrun: runs/SOI_coupler\nprocessor: GPU\ncpu threads: 48\n\nnres: 10.0\ncourant: 0.9\nsubpixel_smoothing: 1\n  \nboundaries: [:PML :PML; :PML :PML; :PML :PML]\n\nsources\n   o1: -9, -2.0, 0 \n\nmonitors\n   o1: -8, -2, 0 \n   o2: -8, 2, 0 \n   o3: 8, 2, 0 \n   o4: 8, -2, 0 \n\noriginal size: (397, 161, 43)\npadded size: (524, 211, 70)\ncell count: 7,739,480\n\nstep size: 102.0 steps/period\nsource duration: 7.97 periods\n\nmax time: 1000.0 periods\nmax steps: 102,000\nmax load: 789,426,960,000 cell-steps\nenergy decay threshold: 0.001\n\n"},"children":[],"key":"qDl3C5SPIn"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"========================================\nrunning simulation...\n"},"children":[],"key":"Mh470rf3R4"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"accumulating dft field...\n"},"children":[],"key":"OHpkr0CVaH"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"period 10, decay: 0.99, 0.92 seconds/period, 855.48 Mcells/s\n"},"children":[],"key":"CG8IsE0eEX"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"period 20, decay: 0.99, 0.065 seconds/period, 12144.13 Mcells/s\n"},"children":[],"key":"ZkPKWTfUzp"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"period 30.0, decay: 0.97, 0.064 seconds/period, 12269.94 Mcells/s\n"},"children":[],"key":"a7FZTxJvgP"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"period 40, decay: 0.96, 0.066 seconds/period, 11879.12 Mcells/s\n"},"children":[],"key":"h0pHSVvCmF"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"period 50, decay: 0.95, 0.065 seconds/period, 12210.19 Mcells/s\n"},"children":[],"key":"ypeGH1Pz3V"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"period 60.0, decay: 0.307, 0.065 seconds/period, 12153.99 Mcells/s\n"},"children":[],"key":"Ks9RGIiFRe"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"period 65.25 stop on energy decay\n12131.62 Mcells/s\n"},"children":[],"key":"ROFEPG9wON"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"simulation completed.\n"},"children":[],"key":"AcatlxKCNV"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"28b9ddda2205c51ab14560bbb0ae18fd","path":"/_public/28b9ddda2205c51ab14560bbb0ae18fd.png"},"text/plain":{"content":"<Figure size 400x894 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"MkjWFaXD3r"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"09caceebade6e3b10abf34b69962876a","path":"/_public/09caceebade6e3b10abf34b69962876a.png"},"text/plain":{"content":"<Figure size 400x894 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"p3WzNMCGSY"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"bf2a67c76ccc2c389a9e0208680d0471","path":"/_public/bf2a67c76ccc2c389a9e0208680d0471.png"},"text/plain":{"content":"<Figure size 400x894 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"zhQm0xXXEa"}],"key":"m8HCy6c4u4"}],"identifier":"576696f9","html_id":"576696f9","key":"lNgnCLaFij"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Results","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cJb1AEcTJN"}],"identifier":"results","label":"Results","html_id":"results","implicit":true,"key":"llP9qvgQl6"}],"identifier":"213f03e9","html_id":"213f03e9","key":"csjq1yXdPB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-17T14:48:20.758076Z","iopub.status.busy":"2026-11-17T14:48:20.758003Z","iopub.status.idle":"2026-11-17T14:48:20.806352Z","shell.execute_reply":"2026-11-17T14:48:20.806029Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"sol = lumi.load(path)\nm = sol[\"monitors\"]\na1 = m[\"o1\"][\"modes\"][0][\"-\"]\nT3 = np.abs(m[\"o3\"][\"modes\"][0][\"+\"] / a1) ** 2\nT4 = np.abs(m[\"o4\"][\"modes\"][0][\"+\"] / a1) ** 2\nwls = np.array(wavelengths)\n\n# 50/50 crossing\ndiff = T3 - T4\ni = np.where(np.diff(np.sign(diff)))[0][0]\nt = diff[i] / (diff[i] - diff[i + 1])\nwl_cross = wls[i] + t * (wls[i + 1] - wls[i])\nT_cross = (T3[i] + T4[i]) * (1 - t) + (T3[i + 1] + T4[i + 1]) * t\nprint(f\"50/50 at {wl_cross:.3f} um, total transmission {T_cross:.3f}\")\n\nplt.plot(wls, T3, label=\"port 3\")\nplt.plot(wls, T4, label=\"port 4\")\nplt.axvline(wl_cross, color=\"gray\", ls=\"--\")\nplt.xlabel(\"wavelength [um]\")\nplt.ylabel(\"transmittance\")\nplt.legend()\nplt.show()","key":"Uhg8atncsu"},{"type":"outputs","id":"E7koSp_5lwZeJDf2RwC12","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"loading solution from runs/SOI_coupler\nmay take a minute if simulation folder is remotely mounted\n50/50 at 1.531 um, total transmission 0.993\n"},"children":[],"key":"zPntSA25fB"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"c0467baec1b31e7e2821b36ab7c26910","path":"/_public/c0467baec1b31e7e2821b36ab7c26910.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"T7eqSeqTNj"}],"key":"fCB0OeKDUg"}],"identifier":"c95eede0","html_id":"c95eede0","key":"JOlE75lZTX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"l