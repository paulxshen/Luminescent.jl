{"version":3,"kind":"Notebook","sha256":"b1677eea5448a0d00ffeb2e7d34036847590b1686ceb929bcbf7d0a0e8e95200","slug":"gc-invd","location":"/GC_invd.ipynb","dependencies":[],"frontmatter":{"title":"Inverse designed grating coupler","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"github":"https://github.com/paulxshen/Luminescent.jl","numbering":{"title":{"offset":2}},"source_url":"https://github.com/paulxshen/Luminescent.jl/blob/main/docs/GC_invd.ipynb","edit_url":"https://github.com/paulxshen/Luminescent.jl/edit/main/docs/GC_invd.ipynb","exports":[{"format":"ipynb","filename":"GC_invd.ipynb","url":"/Luminescent.jl/_public/GC_invd-1b42bc7b1914bd4eff920e78a954bb73.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Inverse design of grating coupler on SOI for angled fiber. (inverse design not available in free version)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JR61NRCnhz"}],"key":"mMxmgFCtO8"}],"identifier":"3b6816f0","html_id":"3b6816f0","key":"KJwe5IKJv7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Config","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"avuM2lRrIR"}],"identifier":"config","label":"Config","html_id":"config","implicit":true,"key":"au1Pp9Wrpn"}],"identifier":"5dfa9785","html_id":"5dfa9785","key":"oFgvHGsIsF"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T02:31:24.462873Z","iopub.status.busy":"2026-11-07T02:31:24.462805Z","iopub.status.idle":"2026-11-07T02:31:25.573097Z","shell.execute_reply":"2026-11-07T02:31:25.572519Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import os\nimport numpy as np\nimport matplotlib.pyplot as plt\n\nimport gdsfactory as gf\nfrom gdsfactory.technology import LogicalLayer, LayerLevel, LayerStack\nimport luminescent as lumi\nfrom scipy.spatial import ConvexHull\n\npath = os.path.join(\"runs\", \"GC_invd\")\n\nwl = 1.55\nbandwidth = 0.01\nnwls = 3\nwls = np.linspace(wl - bandwidth / 2, wl + bandwidth / 2, nwls)\n\n# simulation parameters\nnres = 10\nboundaries = [\"PML\", [\"PEC\", \"PML\"], \"PML\"]\n# PML_decay = [0.01, 0.3, 0.01]\nPML_decay = [0.001, 0.1, 0.001]\ncourant = 0.95\n# shutoff=.001\nshutoff=None\n\n# horizontal dimensions\nD = 10.4  # mode field diameter, SMF-28\nR = 1.5 * D/2  # beam frame half width\n# flare = 25  # waveguide flare full angle (deg)\n# W = 3 * D\n# L = W\n# L = W/2/np.tan(flare/2/180*np.pi)\n# elliptical grating coupler whose outline is the design contour\nn_periods = 16\nperiod = 0.635\nfill_factor = 0.5\ntaper_length = 15.0\ntaper_angle = 40.0\nw_wg = 0.5\n# l_wg =1\nl_wg = 2\nl_flare = .5\n\n# margin = .5\nmargin = 1\n# nox=1.44\nnox = 1.444\n# vertical dimensions\n# theta = 7 * np.pi / 180 # beam angle\ntheta = 6.9 * np.pi / 180  # beam angle\nh_wg = 0.22\n# h_etch = 0.08\nh_etch = 0.10\nh_slab = h_wg-h_etch\n# h_box = 2.0  # buried oxide\nh_box = (1 + .5) *wl / (2 * nox * np.cos( theta))\n# h_sub = 0.3  # substrate thickness in domain\n\n# zmargin = .6\nzmargin = 1\n# port_offset = 0.3\nport_offset = zmargin\n# source_offset = 0.3\nsource_offset = 0.25\nz_port = h_wg + port_offset\n\n# zmin = -h_box - h_sub\n# zmin = -h_box\nzmin = -zmargin\nzmax = h_wg + port_offset + source_offset\n\n# movie parameters\nshot_every = 10\n\nviews = [\n    lumi.view(\"Ey\", y=0, z=h_slab+h_etch/2,mirrors = [\"y-\"]),\n]\n\n# materials\ncore = \"Si\"\nclad = \"SiO2\"\nmaterials = {\n    # \"Si\": lumi.material(3.45),\n    # \"SiO2\": lumi.material(1.44),\n    \"Si\": lumi.material(3.478),\n    \"SiO2\": lumi.material(nox),\n}\n\nn_core = materials[core][\"n\"]\nn_clad = materials[clad][\"n\"]\nlambda_core = wl / n_core\nlambda_clad = wl / n_clad\ndx = lambda_core / nres\n\nbackground = clad\nmaterials[\"design\"] = lumi.placeholder_material(n_core)\n\n# layer stack. lower mesh order layers override higher mesh order layers.\nWG = (1, 0)\nCLAD = (2, 0)\nSLAB = (102, 0)\nDESIGN = (1001, 0)\nCONTOUR=(1002,0)\n\nlayers = {\n    \"design\": LayerLevel(\n        layer=LogicalLayer(layer=DESIGN),\n        zmin=h_slab,\n        thickness=h_etch,\n        material=\"design\",\n        mesh_order=1,\n    ),\n    \"rib\": LayerLevel(\n        # layer=LogicalLayer(layer=SLAB),\n        layer=LogicalLayer(layer=CONTOUR),\n        zmin=h_slab,\n        thickness=h_etch,\n        material=core,\n        mesh_order=101,\n    ),\n    \"slab\": LayerLevel(\n        layer=LogicalLayer(layer=SLAB),\n        zmin=0,\n        thickness=h_slab,\n        material=core,\n        mesh_order=102,\n    ),\n    \"core\": LayerLevel(\n        layer=LogicalLayer(layer=WG),\n        zmin=0,\n        thickness=h_wg,\n        material=core,\n        mesh_order=200,\n    ),\n    # \"substrate\": LayerLevel(\n    #     layer=LogicalLayer(layer=CLAD),\n    #     zmin=zmin,\n    #     thickness=h_sub,\n    #     material=core,\n    #     mesh_order=300,\n    # ),\n}\nlayer_stack = LayerStack(layers=layers)\n\noptimizer = lumi.optimizer(\n    stoploss=0.1,\n    lowloss=0.5,\n    # iters=20,\n    iters=40,\n    contrast=0,\n    momentum=0.7,\n)\ntargets = [\n    lumi.target(src=\"o2@0-\", dst=\"o1@0+\", target=1, weight=1 / nwls, wl=wl)\n    for wl in wls\n]\nlmin=.1","key":"WJMLTmqv01"},{"type":"outputs","id":"yoV7reB41QrgjEtVvOccg","children":[],"key":"KSBn3eGCF9"}],"identifier":"65b4c70d","html_id":"65b4c70d","key":"Wxl9KH52Rv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Geometry","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"u9QBisi6dX"}],"identifier":"geometry","label":"Geometry","html_id":"geometry","implicit":true,"key":"EnKUg7jALe"}],"identifier":"73aa976d","html_id":"73aa976d","key":"szK7eLzqLg"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T02:31:25.574213Z","iopub.status.busy":"2026-11-07T02:31:25.573942Z","iopub.status.idle":"2026-11-07T02:31:25.682687Z","shell.execute_reply":"2026-11-07T02:31:25.682262Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Build the gdsfactory component to be optimized (upper half, mirrored about y=0).\n# design contour: outline of elliptical grating coupler, grating center at x=0 under beam\ngc = gf.components.grating_coupler_elliptical_uniform(\n    n_periods=n_periods,\n    period=period,\n    fill_factor=fill_factor,\n    taper_length=taper_length,\n    taper_angle=taper_angle,\n    wavelength=wl,\n    fiber_angle=np.degrees(theta),\n    nclad=nox,\n    # layer_slab=None,\n    layer_slab=SLAB,\n    cross_section=gf.cross_section.cross_section(width=w_wg, layer=WG),\n)\nq = np.vstack([np.array(p) for ps in gc.get_polygons_points(layers=[WG]).values() for p in ps])\nq = q[ConvexHull(q).vertices] - [gc.ports[\"o2\"].x, 0]\np = np.c_[q[:, 0], np.maximum(q[:, 1], 0)]  # upper half\nx_design, L, W = p[:, 0].min(), np.ptp(p[:, 0]), 2 * p[:, 1].max()\n\n# x_design = -L + R\n# x_flare = ox_design - l_flare\n# x_wg = x_flare - l_wg\n\nc = gf.Component()\nfor layer in (DESIGN, ):\n    rect = c << gf.components.rectangle(size=(L, W / 2), layer=layer)\n    rect.movex(x_design)\n\n# w_flare = w_wg / 2 + l_flare * np.tan(np.radians(flare / 2))\nx_wg=x_design-l_wg\n# p=[(x_design,0),(x_design,w_wg/2),(x_design+L,W/2),(x_design+L,0)]\nc.add_polygon([(x_wg, 0), (x_wg, w_wg / 2), (x_design, w_wg / 2), (x_design,0)], layer=WG)\nc.add_polygon(p, layer=CONTOUR)\nc.add_polygon(p, layer=SLAB)\nfor ps in gc.get_polygons_points(layers=[SLAB]).values():  # slab overhang, as in GC\n    for s in ps:\n        s = np.array(s) - [gc.ports[\"o2\"].x, 0]\n        c.add_polygon(np.c_[s[:, 0], np.maximum(s[:, 1], 0)], layer=SLAB)\n\n# c << gf.components.bbox(component=c, layer=CLAD, top=margin, right=margin)\n# c << gf.components.bbox(  # also enclose beam frame\n#     component=c,\n#     layer=CLAD,\n#     top=max(margin, R + margin - W / 2),\n#     right=max(margin, R + margin - x_design - L),\n# )\nx_fiber = np.sin(theta) * (port_offset + source_offset)\nc << gf.components.bbox(  # enclose beam frame, as in GC\n    component=c,\n    layer=CLAD,\n    top=margin,\n    right=max(0, x_fiber + R - c.xmax),\n)\n\nc.add_port(\"o1\", center=(x_wg, 0), width=w_wg / 2, orientation=180, layer=WG)\n\n\nc.plot()","key":"DyBtpaeI0h"},{"type":"outputs","id":"V_fhDIV0fWdxHnjFiBcYN","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"70ddcae42c76e49a648e58652a5e9af8","path":"/Luminescent.jl/_public/70ddcae42c76e49a648e58652a5e9af8.png"},"text/plain":{"content":"<Figure size 800x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Hlzq9EYHG6"}],"key":"OYFhD9ii2U"}],"identifier":"7f081f36","html_id":"7f081f36","key":"sxndOC10js"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T02:31:25.683551Z","iopub.status.busy":"2026-11-07T02:31:25.683472Z","iopub.status.idle":"2026-11-07T02:31:25.688851Z","shell.execute_reply":"2026-11-07T02:31:25.688522Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"frames = [\n    lumi.plane_frame(\n        \"wg\",\n        start=[-w_wg / 2 - margin, -zmargin],\n        stop=[0, h_wg+zmargin],\n        boundaries=[(\"PML\", \"PEC\"), \"PML\"],\n        wls_mode_solver=[wl],\n    ),\n    lumi.plane_frame(\n        \"beam\",\n        modes=[\n            [\n                lumi.gaussian_mode(\n                    D,\n                    n_clad,\n                    dx=dx,\n                    theta=theta,\n                    wl=wl,\n                    half=\"y+\",\n                    Dlim=2*R,\n                )\n            ]\n        ],\n        start=[-R, 0],\n        stop=[R, R],\n    ),\n]\n\n# origin = [\n#     np.sin(theta) * (source_offset + port_offset),\n#     0,\n#     h_wg + port_offset + source_offset,\n# ]\norigin = [x_fiber, 0, h_wg + port_offset]  # source and beam monitor at same point, as in GC\nbasis = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]\nsources = [\n    lumi.source(\n        \"o2\",\n        origin,\n        basis,\n        wl=wl,\n        bandwidth=max(max(wls) - min(wls), wl / 8),\n        frame=\"beam\",\n    )\n]\n\n# origin = [np.sin(theta) * (port_offset), 0, h_wg + port_offset]\nmonitors = [\n    lumi.gf_monitor(\"o1\", c, layer_stack, frame=\"wg\"),\n    lumi.monitor(\"o2\", origin, basis, frame=\"beam\"),\n]\n\n\ndesigns = [\n    lumi.design(\n        name=\"design\",\n        lmin =lmin,\n        layer=DESIGN,\n        contour_layer=CONTOUR,\n        fill_material=core,\n        void_material=clad,\n        component=c,\n        layer_stack=layer_stack,\n        materials=materials,\n        repdims=[3],\n        anchordims=[],\n    )\n]\n\ntmax =     1./ wl    * (\n        (port_offset + source_offset + 2 * h_box) / np.cos(theta) * n_clad\n        + (L + W / 2 + R + l_wg) * n_core\n    )    + sources[0][\"duration\"]\n\nbbox = c.bbox_np().tolist()\nbbox[0].append(zmin)\nbbox[1].append(zmax)","key":"j7fUn69Ggu"},{"type":"outputs","id":"dsZFlQ9CwpKJXtbS3IMVa","children":[],"key":"hEmGCrjKau"}],"identifier":"09d79bbe","html_id":"09d79bbe","key":"Nh4yomZkbc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Solve","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i2FD8fXTYR"}],"identifier":"solve","label":"Solve","html_id":"solve","implicit":true,"key":"kn3zzyInAX"}],"identifier":"a1d623c6","html_id":"a1d623c6","key":"FkoiYDGMEb"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T02:31:25.689724Z","iopub.status.busy":"2026-11-07T02:31:25.689655Z","iopub.status.idle":"2026-11-07T02:31:25.793353Z","shell.execute_reply":"2026-11-07T02:31:25.792913Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"lumi.mesh(path, c, layer_stack, materials, zmin, zmax)\nlumi.setup(\n    path=path,\n    wl=wl,\n    wls=wls,\n    frames=frames,\n    monitors=monitors,\n    sources=sources,\n    boundaries=boundaries,\n    bbox=bbox,\n    materials=materials,\n    background=background,\n    nres=nres,\n    tmax=tmax,\n    PML_decay=PML_decay,\n    courant=courant,\n    shutoff=shutoff,\n    shot_every=shot_every,\n    views=views,\n    designs=designs,\n    targets=targets,\n    optimizer=optimizer,\n    # load_designs=['design']\n)","key":"SrUG4kMmbm"},{"type":"outputs","id":"Q0HmDrCzPEu8GRKhSnqTs","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Warning: boolean difference failed at index 1: Difference only defined over two meshes.\n"},"children":[],"key":"CU5YrBj2Qe"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"44b314ab1de5ecc47c791f4a2f667b58","path":"/Luminescent.jl/_public/44b314ab1de5ecc47c791f4a2f667b58.png"},"text/plain":{"content":"<Figure size 640x480 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"ZnNpjadVIi"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"using simulation folder runs/GC_invd\n"},"children":[],"key":"kr5AjK8Wrc"}],"key":"bOoI63vfK1"}],"identifier":"dd736514","html_id":"dd736514","key":"vb5YyprMuC"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T02:31:25.7941