            "source": [
                "frames = [\n",
                "    lm.Frame(\n",
                "        \"wg\",\n",
                "        start=[-w_wg / 4 - margin, zmin],\n",
                "        stop=[w_wg / 4, zmax],\n",
                "        boundaries=[(\"PML\", \"PEC\"), \"PML\"],\n",
                "        mode_solver_wavelengths=[wavelength],\n",
                "    ),\n",
                "    lm.Frame(\n",
                "        \"beam\",\n",
                "        modes=[\n",
