                "# Build the gdsfactory component to be optimized.\n",
                "c = gf.Component()\n",
                "d = c << lm.mimo(\n",
                "    l_design,\n",
                "    w_design / 2,\n",
                "    west=[w_wg / 4],\n",
                "    w_wg=w_wg / 2,\n",
                "    l_wg=l_wg,\n",
                "    layer_wg=WG,\n",
                "    layer_design=(DESIGN,),\n",
                "    layer_fill=SLAB,\n",
                "    taper=[(taper / 2, 0)],\n",
                ")\n",
                "\n",
                "ox_design = -l_design + R\n",
                "d.movex(ox_design)\n",
                "\n",
                "c << gf.components.bbox(component=c, layer=CLAD, top=margin, right=margin)\n",
                "\n",
                "c.add_port(\"o1\", port=d.ports[\"o1\"])\n",
                "\n",
                "c.plot()"
            ]
