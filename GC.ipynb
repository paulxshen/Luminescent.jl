    "params_history=[]\n",
    "efficiency_history=[]\n",
    "params=[n_periods, period, fill_factor, taper_length, taper_angle]\n",
    "efficiency=0\n",
    "goal=.4 # uniform grating coupler can reach only 0.4 efficiency at best. for better, use apodization or inverse design\n",
    "maxiter = 10\n",
    "for iter in range(maxiter):\n",
    "    path = os.path.join(\"runs\", f\"GC_opt_{iter}\")\n",
    "    setup(path, wavelength, wavelengths, *params)\n",
    "    lm.solve(path)\n",
    "    \n",
    "    sol = lm.load(path)\n",
    "    fiber_mode = sol[\"monitors\"][\"fiber\"][\"modes\"][0][\"-\"]\n",
    "    wg_mode = sol[\"monitors\"][\"wg\"][\"modes\"][0][\"+\"]\n",
    "    S = np.abs(wg_mode /fiber_mode) ** 2\n",
    "    efficiency = S[nwls // 2]\n",
    "\n",
    "    params_history.append(params.copy())\n",
    "    efficiency_history.append(efficiency)\n",
    "    print(f'{iter}: params={params}, efficiency={efficiency:.4f}')\n",
    "\n",
    "    # todo for reader: use a black-box optimizer to update params\n",
    "    break\n",
    "\n",
    "    if efficiency > goal:\n",
    "        break"
