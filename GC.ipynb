                "            ]\n",
                "        ],\n",
                "        start=[-R, 0],\n",
                "        stop=[R, R],\n",
                "    ),\n",
                "]\n",
                "\n",
                "origin = [\n",
                "    np.sin(theta) * (source_offset + port_offset),\n",
                "    0,\n",
                "    h_wg + port_offset + source_offset,\n",
                "]\n",
                "basis = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]\n",
                "sources = [\n",
