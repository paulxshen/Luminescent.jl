    "import os\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "import gdsfactory as gf\n",
    "from gdsfactory.technology import LogicalLayer, LayerLevel, LayerStack\n",
    "import luminescent as lm\n",
    "\n",
    "# SOI grating-coupler dimensions [um]\n",
    "w_wg = 0.5\n",
    "taper_length = 15.0\n",
    "n_periods = 25\n",
    "fill_factor = 0.5\n",
    "fiber_angle = 6.9 # in clad or 10deg in air\n",
    "taper_angle = 40.0\n",
    "period=.61\n",
    "\n",
    "# SOI dimensions [um]: 220 nm silicon with a 130 nm residual slab\n",
    "h_core = 0.22\n",
    "h_slab = 0.13\n",
    "h_teeth = h_core - h_slab\n",
    "\n",
    "# wavelengths [um]\n",
    "wavelength = 1.55\n",
    "bandwidth = 0.1\n",
    "nwls = 11\n",
    "wavelengths = np.linspace(wavelength - bandwidth / 2, wavelength + bandwidth / 2, nwls)\n",
    "\n",
    "# Gaussian fiber mode dimensions [um]\n",
    "r_beam = 5.0\n",
    "R_beam = 1.5*r_beam\n",
    "fiber_offset = 0.6\n",
    "\n",
    "\n",
    "def setup(path, wavelength, wavelengths,n_periods, period,fill_factor, taper_length, taper_angle):\n",
    "    boundaries = [\"PML\", [\"PEC\", \"PML\"], \"PML\"]\n",
    "    nres = 6\n",
    "    stop_decay = 5e-3\n",
    "    tmax = 1000\n",
    "    PML_decay = [0.01, 0.1, 0.01]\n",
    "    shot_every = 10\n",
    "\n",
    "    l_wg = 2\n",
    "    margin = 1.\n",
    "\n",
    "    source_offset = fiber_offset/2\n",
    "    zmargin = .6\n",
    "    zmin =  - zmargin\n",
    "    zmax = h_core + fiber_offset\n",
    "    z_port = zmax - source_offset\n",
    "\n",
    "    nclad = 1.444\n",
    "    materials = {\n",
    "        \"Si\": lm.Material(3.478),\n",
    "        \"SiO2\": lm.Material(nclad),\n",
    "    }\n",
    "    background = \"SiO2\"\n",
    "\n",
    "    WG = (1, 0)\n",
    "    SLAB = (2, 0)\n",
    "    BBOX = (3, 0)\n",
    "    layer_stack = LayerStack(\n",
    "        layers={\n",
    "            \"core\": LayerLevel(\n",
    "                layer=LogicalLayer(layer=WG),\n",
    "                thickness=h_core,\n",
    "                zmin=0,\n",
    "                material=\"Si\",\n",
    "                mesh_order=200,\n",
    "            ),\n",
    "            \"slab\": LayerLevel(\n",
    "                layer=LogicalLayer(layer=SLAB),\n",
    "                thickness=h_slab,\n",
    "                zmin=0,\n",
    "                material=\"Si\",\n",
    "                mesh_order=100,\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "    c = gf.Component()\n",
    "    gc = c << gf.components.grating_coupler_elliptical_uniform(\n",
    "        n_periods=n_periods,\n",
    "        period=period,\n",
    "        fill_factor=fill_factor,\n",
    "        taper_length=taper_length,\n",
    "        taper_angle=taper_angle,\n",
    "        wavelength=wavelength,\n",
    "        fiber_angle=fiber_angle,\n",
    "        nclad=nclad,\n",
    "        layer_slab=SLAB,\n",
    "        cross_section=gf.cross_section.cross_section(width=w_wg, layer=WG),\n",
    "    )\n",
    "    wg = c << gf.components.straight(\n",
    "        length=l_wg,\n",
    "        cross_section=gf.cross_section.cross_section(width=w_wg, layer=WG),\n",
    "    )\n",
    "    wg.connect(\"o2\", gc.ports[\"o1\"])\n",
    "    c << gf.components.bbox(component=c, layer=BBOX, top=margin, bottom=margin)\n",
    "    full_bbox = c.bbox_np().tolist()\n",
    "\n",
    "    clipper = gf.Component()\n",
    "    clipper_ref = clipper << gf.components.rectangle(\n",
    "        size=(full_bbox[1][0] - full_bbox[0][0], full_bbox[1][1]),\n",
    "        layer=WG,\n",
    "    )\n",
    "\n",
    "    half_component = gf.Component()\n",
    "    clipper_ref.movex(full_bbox[0][0])\n",
    "    for layer in (WG, SLAB, BBOX):\n",
    "        clipped = gf.boolean(\n",
    "            c,\n",
    "            clipper,\n",
    "            operation=\"and\",\n",
    "            layer=layer,\n",
    "            layer1=layer,\n",
    "            layer2=WG,\n",
    "        )\n",
    "        half_component << clipped\n",
    "    half_component.add_port(\"wg\", port=gc.ports[\"o1\"])\n",
    "    half_component.flatten()\n",
    "    c = half_component\n",
    "    c.plot()\n",
    "\n",
    "    bbox = c.bbox_np().tolist()\n",
    "    bbox[0][1] = 0\n",
    "    bbox[0].append(zmin)\n",
    "    bbox[1].append(zmax)\n",
    "\n",
    "# sources, monitors\n",
    "    frames = [\n",
    "        lm.Frame(\n",
    "            \"wg\",\n",
    "            start=[-w_wg / 2 - margin, zmin],\n",
    "            stop=[0, zmax],\n",
    "            boundaries=[(\"PML\", \"PEC\"), \"PML\"],\n",
    "            mode_solver_wavelengths=[wavelength],\n",
    "        ),\n",
    "        lm.Frame(\n",
    "            \"fiber\",\n",
    "            modes=[\n",
    "                [\n",
    "                    lm.gaussian_mode(\n",
    "                        r_beam,\n",
    "                        R_beam,\n",
    "                        Z=1 / nclad,\n",
    "                        dx=wavelength / nclad / nres,\n",
    "                        theta=np.deg2rad(fiber_angle),\n",
    "                        wavelength=wavelength,\n",
    "                        half=\"y+\",\n",
    "                    )\n",
    "                ]\n",
    "            ],\n",
    "            start=[-R_beam, 0],\n",
    "            stop=[R_beam, R_beam],\n",
    "        ),\n",
    "    ]\n",
    "\n",
    "    fiber_origin = [\n",
    "        gc.ports[\"o2\"].center[0] + np.sin(np.deg2rad(fiber_angle)) * fiber_offset,\n",
    "        0,\n",
    "        z_port,\n",
    "    ]\n",
    "    fiber_basis = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]\n",
    "    sources = [\n",
    "        lm.Source(\n",
    "            \"fiber\",\n",
    "            fiber_origin,\n",
    "            fiber_basis,\n",
    "            frame=\"fiber\",\n",
    "            wavelength=wavelength,\n",
    "            bandwidth=wavelength / 5,\n",
    "        )\n",
    "    ]\n",
    "    monitors = [\n",
    "        lm.Monitor(\"wg\", *lm.from_gf_port(c, \"wg\"), frame=\"wg\"),\n",
    "        lm.Monitor(\"fiber\", fiber_origin, fiber_basis, frame=\"fiber\"),\n",
    "    ]\n",
    "\n",
    "    views = [lm.View(\"Ey\", y=0, z=h_slab+h_teeth / 2)]\n",
    "    lm.mesh(path, c, layer_stack, materials, zmin, zmax)\n",
    "    lm.setup(\n",
    "        path=path,\n",
    "        wavelength=wavelength,\n",
    "        wavelengths=wavelengths,\n",
    "        materials=materials,\n",
    "        background=background,\n",
    "        boundaries=boundaries,\n",
    "        bbox=bbox,\n",
    "        frames=frames,\n",
    "        sources=sources,\n",
    "        monitors=monitors,\n",
    "        nres=nres,\n",
    "        tmax=tmax,\n",
    "        stop_decay=stop_decay,\n",
    "        PML_decay=PML_decay,\n",
    "        views=views,\n",
    "        shot_every=shot_every,\n",
    "        device=\"cpu\",\n",
    "    )\n"
   ]
  },
