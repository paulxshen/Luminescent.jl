.json\")\n    st = json.load(open(f)) if os.path.exists(f) else {}\n    rows.append((nres, T3[i], T4[i], loss[i], st.get(\"runtime\"), st.get(\"gpu_GB\"), st.get(\"host_GB\")))\n    ax[0].plot(wls, T3, label=f\"nres {nres}\")\n    ax[1].plot(wls, loss, label=f\"nres {nres}\")\n\nfmt = lambda v, f: \"–\" if v is None else format(v, f)\nprint(\"nres  cross T  through T  excess loss  runtime  GPU mem  host mem\")\nfor nres, t3, t4, l, rt, g, h in rows:\n    print(f\"{nres:4d}  {100*t3:6.1f} %  {100*t4:7.1f} %  {l:8.3f} dB  {fmt(rt, '5.0f'):>5} s  {fmt(g, '5.2f'):>5} GB  {fmt(h, '5.2f'):>5} GB\")\n\nax[0].set(xlabel=\"wavelength [um]\", ylabel=\"cross transmittance\")\nax[1].set(xlabel=\"wavelength [um]\", ylabel=\"excess loss [dB]\")\nax[0].legend()\nplt.tight_layout()\nplt.show()","key":"MupmxYaNqd"},{"type":"outputs","id":"tn0lwiFz6OhQWLpIJtF-b","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"loading solution from runs/dc_nres6\nmay take a minute if simulation folder is remotely mounted\nloading solution from runs/dc_nres10\nmay take a minute if simulation folder is remotely mounted\nloading solution from runs/dc_nres15\nmay take a minute if simulation folder is remotely mounted\nnres  cross T  through T  excess loss  runtime  GPU mem  host mem\n   6    43.6 %     51.4 %     0.223 dB    138 s   1.36 GB   2.54 GB\n  10    41.3 %     57.8 %     0.040 dB    158 s   3.61 GB   3.87 GB\n  15    43.3 %     55.8 %     0.038 dB    287 s  11.55 GB   5.11 GB\n"},"children":[],"key":"X2HVE7udz5"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5a9eb673786e9139b53287d96512d92d","path":"/Luminescent.jl/_public/5a9eb673786e9139b53287d96512d92d.png"},"text/plain":{"content":"<Figure size 1000x400 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"AIloyboARE"}],"key":"pdpxQ1jpM3"}],"identifier":"ced902be","html_id":"ced902be","key":"PeMPnkjoGZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Fig. 4a comparison","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wOD57Iew8H"}],"identifier":"fig-4a-comparison","label":"Fig. 4a comparison","html_id":"fig-4a-comparison","implicit":true,"key":"rYTjGh0HWj"}],"identifier":"be8aaaad","html_id":"be8aaaad","key":"Sln6cAOhG1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-07T15:04:52.737428Z","iopub.status.busy":"2026-11-07T15:04:52.737349Z","iopub.status.idle":"2026-11-07T15:04:52.805022Z","shell.execute_reply":"2026-11-07T15:04:52.804696Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# paper Fig. 4a, digitized\nnres_paper = [6, 10, 15, 20, 25]\nT_tidy3d = [0.697, 0.579, 0.448, 0.492, 0.456]\nT_lumerical = [0.493, 0.451, 0.411, 0.446, 0.431]\n\nplt.figure(figsize=(5, 3.5))\nplt.plot(nres_paper, T_lumerical, \"o-\", color=\"red\", label=\"Lumerical\")\nplt.plot(nres_paper, T_tidy3d, \"o-\", color=\"blue\", label=\"Tidy3D\")\nplt.plot([r[0] for r in rows], [r[1] for r in rows], \"o-\", color=\"black\", label=\"Luminescent\")\nplt.xlabel(\"nres (cells per wavelength)\")\nplt.ylabel(\"transmission\")\nplt.title(\"Cross port TE0 at 1550 nm\")\nplt.grid(alpha=0.3)\nplt.legend()\nplt.show()","key":"nAgiqPFjXZ"},{"type":"outputs","id":"y0_UdN27J8GKWyxWNJ_lX","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4a5130f0b389776133d68ff74da17e0b","path":"/Luminescent.jl/_public/4a5130f0b389776133d68ff74da17e0b.png"},"text/plain":{"content":"<Figure size 500x350 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"VDnZO9exuP"}],"key":"P6YC2kESn9"}],"identifier":"5a997412","html_id":"5a997412","key":"fFnWIAziXY"},{"type":"block","kind":"no