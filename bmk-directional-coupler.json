loss[i], st.get(\"runtime\"), st.get(\"gpu_GB\"), st.get(\"host_GB\")))\n    ax[0].plot(wls, T3, label=f\"nres {nres}\")\n    ax[1].plot(wls, loss, label=f\"nres {nres}\")\n\nfmt = lambda v, f: \"–\" if v is None else format(v, f)\nprint(\"nres  cross T  through T  excess loss  runtime  GPU mem  host mem\")\nfor nres, t3, t4, l, rt, g, h in rows:\n    print(f\"{nres:4d}  {100*t3:6.1f} %  {100*t4:7.1f} %  {l:8.3f} dB  {fmt(rt, '5.0f'):>5} s  {fmt(g, '5.2f'):>5} GB  {fmt(h, '5.2f'):>5} GB\")\n\nax[0].set(xlabel=\"wavelength [um]\", ylabel=\"cross transmittance\")\nax[1].set(xlabel=\"wavelength [um]\", ylabel=\"excess loss [dB]\")\nax[0].legend()\nplt.tight_layout()\nplt.show()","key":"cys9jkjkXU"},{"type":"outputs","id":"sRV3wwAWcH30IEAm9olGi","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"loading solution from runs/dc_nres6\nmay take a minute if simulation folder is remotely mounted\nloading solution from runs/dc_nres10\nmay take a minute if simulation folder is remotely mounted\nloading solution from runs/dc_nres15\nmay take a minute if simulation folder is remotely mounted\nnres  cross T  through T  excess loss  runtime  GPU mem  host mem\n   6    43.6 %     51.4 %     0.223 dB    138 s   1.36 GB   2.54 GB\n  10    41.3 %     57.8 %     0.040 dB    158 s   3.61 GB   3.87 GB\n  15    43.3 %     55.8 %     0.038 dB    287 s  11.55 GB   5.11 GB\n"},"children":[],"key":"VTBA8i5WMB"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5a9eb673786e9139b53287d96512d92d","path":"/_public/5a9eb673786e9139b53287d96512d92d.png"},"text/plain":{"content":"<Figure size 1000x400 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"L3DJYAr3x5"}],"key":"DPqH5bI9cA"}],"identifier":"ced902be","html_id":"ced902be","key":"A8BFf0bGcy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"colu