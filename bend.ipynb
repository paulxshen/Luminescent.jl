                "        subpixel_smoothing=subpixel_smoothing,\n",
                "        tmax=tmax,\n",
                "        PML_decay=PML_decay,\n",
                "        #\n",
                "        views=views,\n",
                "        shot_every=shot_every,\n",
                "        stop_decay=stop_decay,\n",
                "        device='cpu'\n",
                "    )\n",
                "\n",
